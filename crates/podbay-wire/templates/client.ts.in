const ERROR_CODES = ["invalid_input", "unsupported", "forbidden", "conflict", "stale_guard", "busy", "external_writer", "unavailable", "uncertain", "storage_failure", "deadline_exceeded", "limit_exceeded", "replay_gap"] as const;
