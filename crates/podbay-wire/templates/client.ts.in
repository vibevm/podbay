export interface WireTransport {
  exchange(frame: Uint8Array): Promise<Uint8Array>;
}
export class PodBayWireClient {
  readonly transport: WireTransport;
  constructor(transport: WireTransport) { this.transport = transport; }
  async command(command: CommandEnvelope): Promise<Receipt<unknown>> {
    await decodeCommand(command);
    const response = parse(decodeFrame(await this.transport.exchange(encodeFrame(command))));
    const item = record(response, "response");
    if (Object.hasOwn(item, "error")) {
      const error = decodeError(item);
      if (error.requestId !== command.requestId) throw new TypeError("response requestId mismatch");
      throw new PodBayWireError(error);
    }
    const success = decodeSuccess(item);
    if (success.requestId !== command.requestId) throw new TypeError("response requestId mismatch");
    return decodeReceipt(success.ok);
  }
  async read(request: ReadEnvelope): Promise<unknown> {
    validateRead(request);
    const response = parse(decodeFrame(await this.transport.exchange(encodeFrame(request))));
    const item = record(response, "response");
    if (Object.hasOwn(item, "error")) {
      const error = decodeError(item);
      if (error.requestId !== request.requestId) throw new TypeError("response requestId mismatch");
      throw new PodBayWireError(error);
    }
    const success = decodeSuccess(item);
    if (success.requestId !== request.requestId) throw new TypeError("response requestId mismatch");
    return success.ok;
  }
}
